# ─── Copie para .env antes de subir o docker compose ───

# Backend
PORT=7000
JWT_SECRET=fd5g4dgdf6dsnjkdsuhguiew4485hfgh2f3h15fgh
JWT_EXPIRES_IN=3600s

# PostgreSQL (um único banco para todo o backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image-platform
DATABASE_URL=postgresql://postgres:postgres@12345894560064979506394:5435/image-platform?schema=public

# Redis (read model do CQRS)
REDIS_URL=redis://redis:6379

# RabbitMQ (mensageria entre os módulos)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Frontend (mesma origem para API e WebSocket — o backend serve os dois)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
